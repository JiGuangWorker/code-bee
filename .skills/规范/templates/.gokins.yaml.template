# 极光 AI · Gokins CLI 部署配置
# 用法: gokins deploy
# 对应规范: 部署规范.md
#
# 此文件是项目模板，各项目拷贝到根目录后使用。
# 需要修改: targets 中的服务器地址、认证方式、部署路径。

# ============================================================
# 目标服务器
# ============================================================
targets:
  - name: staging
    host: 10.0.1.100
    port: 22
    user: deploy
    # 认证方式：SSH Key（推荐）或密码
    auth:
      key: ~/.ssh/deploy_rsa
    # 部署路径
    path: /opt/app/staging

  - name: production
    host: 10.0.2.100
    port: 22
    user: deploy
    auth:
      key: ~/.ssh/deploy_rsa
    path: /opt/app/production

# ============================================================
# 构建产物
# ============================================================
artifact:
  # 后端二进制
  backend: backend/bin/server
  # 前端构建产物
  frontend: frontend/packages/app/dist

# ============================================================
# 部署前执行的命令（本地构建）
# ============================================================
pre_deploy:
  - go build -o backend/bin/server ./backend/cmd/server
  - cd frontend && pnpm build

# ============================================================
# 部署后执行的命令（目标服务器）
# ============================================================
post_deploy:
  - systemctl restart myapp

# ============================================================
# 健康检查
# ============================================================
health_check:
  url: http://localhost:8080/health
  retries: 5
  interval: 3s
