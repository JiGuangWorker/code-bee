# code-bee · 项目统一操作入口

.PHONY: help build test lint check-structure check-all clean

# 默认目标
help:
	@echo "code-bee · Issue-driven AI coding scheduler"
	@echo ""
	@echo "  make build             编译二进制"
	@echo "  make test              运行测试"
	@echo "  make lint              Go 代码静态分析"
	@echo "  make check-structure   项目目录结构校验"
	@echo "  make check-all         全部校验"
	@echo "  make clean             清理编译产物"
	@echo ""

# ============================================================
# 编译
# ============================================================
build:
	@echo "→ 编译 code-bee..."
	go build -o bin/code-bee ./cmd/worker/

# ============================================================
# 测试
# ============================================================
test:
	@echo "→ 运行测试..."
	go test -race -v ./...

# ============================================================
# 静态分析
# ============================================================
lint:
	@echo "→ golangci-lint 代码检查..."
	golangci-lint run -c .golangci.yml ./...

# ============================================================
# 目录结构校验
# ============================================================
check-structure:
	@echo "→ conform 目录结构校验..."
	conform enforce

# ============================================================
# 全部校验
# ============================================================
check-all: lint check-structure
	@echo ""
	@echo "✅ 全部校验通过"

# ============================================================
# 清理
# ============================================================
clean:
	@echo "→ 清理编译产物..."
	rm -rf bin/
