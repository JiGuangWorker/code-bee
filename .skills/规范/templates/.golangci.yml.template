# 极光 AI · Go 编码规范检查配置
# 用法: golangci-lint run -c .golangci.yml
# 对应规范: 编码规范.md 第二章（Go 编码规范）
#
# 此文件是项目模板，各 Go 项目拷贝到根目录后使用。
# 需要修改: goimports.local-prefixes 改为实际模块前缀。

run:
  timeout: 5m
  tests: true

# ============================================================
# Linter 启用清单（每个对应编码规范中的规则）
# ============================================================
linters:
  enable:
    # 2.2 错误处理：禁止 _ 吞 error
    - errcheck

    # 2.3 包导入顺序：标准库 → 第三方 → 本项目
    - goimports

    # 2.5 Context + 代码风格（context 位置、导出符号注释等）
    - revive

    # 通用原则：函数不超过 80 行
    - funlen

    # 通用原则：禁止魔法数字
    - mnd

    # 通用原则：函数圈复杂度控制
    - gocyclo

    # 基础保障
    - govet
    - staticcheck
    - unused
    - gosec

# ============================================================
# 各 Linter 配置
# ============================================================
linters-settings:
  # ---------- 2.2 错误处理 ----------
  errcheck:
    # 也检查 _ 赋值的 error（如 user, _ := fn()）
    check-blank: true
    # 不检查类型断言（_, ok := x.(T) 是合法惯用法）
    check-type-assertions: false

  # ---------- 2.3 包导入顺序 ----------
  goimports:
    # 【必须修改】改为实际 Go module 前缀
    local-prefixes: github.com/your-org

  # ---------- 2.5 Context + 代码风格 ----------
  revive:
    rules:
      # context 必须是第一个参数
      - name: context-as-argument
      # 导出符号应有注释（仅警告）
      - name: exported
        severity: warning
      # 禁止空代码块
      - name: empty-block

  # ---------- 通用原则：函数长度 ----------
  funlen:
    # 编码规范要求：函数不超过 80 行
    lines: 80
    statements: 40

  # ---------- 通用原则：魔法数字 ----------
  mnd:
    # 这些数字在所有场景下都是合理的，不再警告
    ignored-numbers: "0,1,2,10,100,1000"

  # ---------- 通用原则：圈复杂度 ----------
  gocyclo:
    min-complexity: 15

# ============================================================
# 排除规则
# ============================================================
issues:
  exclude-rules:
    # 测试文件放宽限制
    - path: _test\.go
      linters:
        - errcheck
        - funlen
        - mnd
        - gocyclo

    # wire 自动生成文件跳过
    - path: wire\.go
      linters:
        - errcheck

  # 不设上限，看到所有问题
  max-issues-per-linter: 0
  max-same-issues: 0
